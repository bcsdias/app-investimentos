# Template de Segredos para o Streamlit (Fase 2)
# Renomeie este arquivo para 'secrets.toml' e preencha os valores antes de rodar o app.

# 1. Google OAuth2 (Google Cloud Console)
# Redirect URI recomendada: http://localhost:8501/oauth2callback
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "GERAR_UMA_STRING_ALEATORIA_LONGA" # Ex: Use 'openssl rand -base64 32'
client_id = "SEU_GOOGLE_CLIENT_ID"
client_secret = "SEU_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# 2. Supabase (Configuração de Banco de Dados)
# Usado para salvar chaves DLP criptografadas e perfis de usuários.
[supabase]
url = "SUA_URL_DO_SUPABASE"
key = "SUA_ANON_PUBLIC_KEY"
service_role_key = "SUA_SERVICE_ROLE_KEY" # Necessária para o backend gerenciar tokens

# 3. Upstash Redis (Cloud Cache)
# Usado para cache distribuído de cotações e dados da planilha.
[upstash_redis]
url = "SUA_URL_REST_DO_UPSTASH_REDIS"
token = "SEU_TOKEN_REST_DO_UPSTASH_REDIS"

# 4. Segurança e Criptografia (Fernet)
# Usada para criptografar os tokens DLP antes de salvar no Supabase.
[security]
# Gere uma nova chave com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
fernet_key = "SUA_CHAVE_FERNET_AQUI"
